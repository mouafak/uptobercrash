# Base de données PostgreSQL
# Les caractères réservés du mot de passe doivent être encodés : @ -> %40
DATABASE_URL=

# Endpoint RPC Solana dédié (Helius, QuickNode…). L'endpoint public est
# limité en débit et fera échouer des vérifications légitimes.
SOLANA_RPC_URL=""

# Identifiant d'environnement Dynamic (public, exposé au navigateur)
NEXT_PUBLIC_DYNAMIC_ENV_ID=""

# Adresse de réception de la trésorerie, en base58 (public)
NEXT_PUBLIC_TREASURY_ADDRESS=""

# Interrupteur d'arrêt : true coupe les achats après redémarrage
SALE_PAUSED=false

# Webhook Discord ou Telegram pour les alertes (optionnel)
ALERT_WEBHOOK_URL=

# Nombre de proxys de confiance devant l'application.
# 1 pour Traefik ou Nginx en frontal, 2 si un CDN s'intercale.
TRUSTED_PROXY_HOPS=1
